# =============================================================================
# INTELORA — Environment Configuration
# Copy to `.env` at the repository root before running `docker compose up`.
# Never commit `.env`. Never place secrets in any VITE_* variable — those are
# compiled into the browser bundle and are publicly readable.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
INTELORA_ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL / TimescaleDB ----------------------------------------------
POSTGRES_USER=intelora
POSTGRES_PASSWORD=intelora
POSTGRES_DB=intelora
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Host port the database is published on (change if 5432 is already in use)
POSTGRES_HOST_PORT=5432

# ---- Backend ----------------------------------------------------------------
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Comma-separated list of origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ---- Digital Twin Engine ----------------------------------------------------
# Master switch. When false the platform runs with no data source attached and
# the dashboard renders its empty states.
TWIN_ENABLED=true

# Telemetry generation interval, in seconds (SSOT: 1 Hz).
TWIN_INTERVAL_SECONDS=1.0

# Virtual device counts per asset type. Raising a count adds devices on the
# next start without disturbing existing ones or their history.
TWIN_LAPTOP_CHARGERS=50
TWIN_MOBILE_CHARGERS=50
TWIN_AIR_CONDITIONERS=20

# Seed for reproducible twin behaviour. Blank means non-deterministic.
TWIN_SEED=20260801

# ---- Intelligence -----------------------------------------------------------
# How often the intelligence layers recompute, in seconds.
INTELLIGENCE_INTERVAL_SECONDS=15.0

# ---- Time-series storage ----------------------------------------------------
# At 120 devices and 1 Hz the platform writes ~10.4 million rows a day, so raw
# retention alone is not a viable read path beyond a few hours. Continuous
# aggregates and compression are what make long ranges answerable. Disable both
# only when running against plain PostgreSQL without TimescaleDB.
TIMESCALE_COMPRESSION_ENABLED=true
TIMESCALE_CONTINUOUS_AGGREGATES_ENABLED=true
TIMESCALE_CHUNK_INTERVAL_HOURS=2
TIMESCALE_COMPRESS_AFTER_HOURS=6

# ---- Frontend (build-time, public) ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
